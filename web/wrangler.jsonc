{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A Worker that only serves static assets: no script, no Pages.
  // Must match the Worker that Workers Builds is connected to in the dashboard.
  "name": "postline",
  // The Nidfultechnologies account, which owns the Worker. Not a secret; it stops
  // wrangler asking which account to use when you're logged into several.
  "account_id": "66325b84ab3d7f68924034bdf5227e65",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "postline.nsisong.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Pull request builds run `wrangler preview` (Cloudflare Previews), which needs
  // this block. It can stay empty: assets and settings above apply to previews too.
  "previews": {}
}
