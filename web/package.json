{
  "name": "postline-site",
  "private": true,
  "description": "postline.nsisong.com: the postline website and documentation, served by Cloudflare Workers.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "check": "tsc -p tsconfig.json",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "marked": "18.1.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  }
}
