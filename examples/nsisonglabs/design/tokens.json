{
  "$description": "Nsisong Labs design tokens (W3C DTCG format). Same values as nsisonglabs.com.",
  "color": {
    "brand": {
      "blue": { "$type": "color", "$value": "#1034a6" },
      "blue-light": { "$type": "color", "$value": "#e6ecfa" },
      "dark": { "$type": "color", "$value": "#191a23" }
    },
    "surface": {
      "page": { "$type": "color", "$value": "#ffffff" },
      "panel": { "$type": "color", "$value": "#f4f7fd" },
      "line": { "$type": "color", "$value": "#dbe3f6" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.brand.dark}" },
      "muted": { "$type": "color", "$value": "#5b6070" },
      "accent": { "$type": "color", "$value": "{color.brand.blue}" }
    }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "Space Grotesk" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "28px" }
  }
}
