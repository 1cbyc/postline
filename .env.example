# LinkedIn (organization page). Needs w_organization_social.
LINKEDIN_ACCESS_TOKEN=
# Bluesky. Use an app password, not your account password.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# Mastodon. Token with write:statuses and write:media.
MASTODON_ACCESS_TOKEN=
# Webhook signing secret (HMAC-SHA256).
POSTLINE_WEBHOOK_SECRET=
# Optional: path to a Chromium binary for `postline render`.
POSTLINE_CHROMIUM=
