{
  "name": "postline",
  "version": "0.2.0",
  "description": "Plan, render and publish branded social posts from a git repo.",
  "license": "MIT",
  "author": "Isaac Emmanuel <ei@nsisong.com> (https://nsisong.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1cbyc/postline.git"
  },
  "homepage": "https://github.com/1cbyc/postline#readme",
  "bugs": "https://github.com/1cbyc/postline/issues",
  "keywords": [
    "social-media",
    "linkedin",
    "bluesky",
    "mastodon",
    "content-calendar",
    "scheduling",
    "marketing",
    "cli"
  ],
  "type": "module",
  "bin": {
    "postline": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "templates",
    "docs/architecture",
    "docs/guides",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "lint:types": "tsc -p tsconfig.json --noEmit",
    "example:lint": "node dist/src/cli.js lint --cwd examples/nsisonglabs",
    "example:render": "node dist/src/cli.js render --cwd examples/nsisonglabs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "playwright-core": "1.64.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
